# Database (Supabase / Neon / local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/tcg_hk?schema=public"

# Auth.js (NextAuth v5)
AUTH_SECRET="openssl rand -base64 32 產生的隨機字串"
ADMIN_EMAIL="admin@trtcg.hk"
ADMIN_PASSWORD="your-secure-password"

# Stripe (Hong Kong)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# App（Vercel 請改為 https://你的專案.vercel.app）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Map 不需 API Key；在後台「網站內容」貼上 iframe src 即可
