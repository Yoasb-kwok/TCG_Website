# Database (Supabase / Neon / local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/tcg_hk?schema=public"

# Auth.js (NextAuth v5)
AUTH_SECRET="openssl rand -base64 32 產生的隨機字串"
ADMIN_EMAIL="admin@trtcg.hk"
ADMIN_PASSWORD="your-secure-password"

# Stripe (Hong Kong)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# App（Vercel 請改為 https://你的專案.vercel.app）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp 浮動按鈕。留空則使用 src/lib/constants.ts 的 STORE.whatsapp（門市公開電話 66094893）。
# 可填 8 位香港號碼，或已含 852 的國際號碼，例如 85266094893。
WHATSAPP_NUMBER=""

# 社交媒體（頁尾「社交媒體」及桌面導覽列圖示）。留空則不顯示該項目，不會出現空連結。
# 請填完整網址，例如 https://www.instagram.com/your-handle
# 新增平台：在 src/lib/social.ts 的 SOCIAL_LINK_SLOTS 加一項，並在 SOCIAL_ENV 讀取對應環境變數。
SOCIAL_INSTAGRAM_URL=""
SOCIAL_FACEBOOK_URL=""

# Google Map 不需 API Key；在後台「網站內容」貼上 iframe src 即可
