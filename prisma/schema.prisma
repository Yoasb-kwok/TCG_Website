generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
  FAILED
  NOT_REQUIRED
}

enum TransactionType {
  ORDER
  TOURNAMENT
}

enum BuyerType {
  USER
  GUEST
}

/// ADR-004: Reasons for point ledger entries
enum PointReason {
  ORDER_EARN
  TOURNAMENT_EARN
  ADMIN_ADJUST
}

enum TournamentStatus {
  DRAFT
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum UserRole {
  USER
  ADMIN
}

/** 後台可管理的標籤類型 */
enum TaxonomyKind {
  SET_CODE
  RARITY
  CARD_NUMBER
  CARD_CATEGORY
  POKEMON_ATTRIBUTE
  PRODUCT_TYPE
}

model TaxonomyOption {
  id          String       @id @default(uuid())
  kind        TaxonomyKind
  /** 儲存值（如 M3、RR、012） */
  value       String
  /** 顯示標籤 */
  label       String
  sortIndex   Int          @default(0)
  /** 卡號可掛在系列底下（parentValue = 系列編號） */
  parentValue String?
  /** 系列固定卡號後綴（SET_CODE 用，如 063 → 001/063） */
  cardSuffix  String?
  active      Boolean      @default(true)
  /// ADR-006: null = shared across all games (e.g. PRODUCT_TYPE); FK = game-specific
  gameTypeId  String?
  gameType    GameType?     @relation(fields: [gameTypeId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([kind, value, parentValue])
  @@index([kind, sortIndex])
  @@index([kind, parentValue])
  @@index([gameTypeId])
}

model User {
  id            String                  @id @default(uuid())
  email         String                  @unique
  name          String?
  phone         String?
  passwordHash  String?
  role          UserRole                @default(USER)
  orders        Order[]
  registrations TournamentRegistration[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

/// 註冊時的 OTP 驗證記錄。帳號在 OTP 驗證後才建立。
model EmailVerification {
  id           String   @id @default(uuid())
  email        String   @unique
  /// 6位數 OTP 驗證碼（bcrypt 雜湊）
  code         String
  /// 註冊表單提交的密碼雜湊
  passwordHash String
  name         String?
  phone        String?
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email, expiresAt])
}

/// 忘記密碼的 OTP 驗證記錄。
model PasswordReset {
  id        String   @id @default(uuid())
  email     String   @unique
  /// 6位數 OTP 驗證碼（bcrypt 雜湊）
  code      String
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}

model Product {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique
  description    String?
  /** 對應標籤管理 PRODUCT_TYPE 的 value（如 SINGLE、BOOSTER_PACK、GIFT_BOX） */
  type           String
  cardSet        String?
  cardNumber     String?
  rarity         String?
  /** 系列編號：M1L、M3、M2A、SV3 等 */
  setCode        String?
  /** 稀有度分類：MUR、SAR、SR、AR、RR、R_SHINY、R、ITEM 等 */
  rarityTier     String?
  /** 卡牌類型：寶可夢、訓練家、物品、能量、場地 */
  cardCategory   String?
  setSortIndex   Int           @default(999)
  raritySortIndex Int          @default(99)
  /** 屬性：草、火、水、雷等（寶可夢卡） */
  pokemonType    String?
  language       String        @default("zh-HK")
  externalCardId String?
  /// ADR-006: Required FK — every product belongs to a game type
  gameTypeId     String
  gameType       GameType       @relation(fields: [gameTypeId], references: [id])
  variants       ProductVariant[]
  images         Image[]
  featuredEntries HomeFeaturedProduct[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([cardSet])
  @@index([rarity])
  @@index([setCode])
  @@index([rarityTier])
  @@index([setSortIndex])
  @@index([raritySortIndex])
  @@index([pokemonType])
  @@index([type])
  @@index([gameTypeId])
}

model HomeBanner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String
  imageUrl  String
  href      String
  gradient  String
  sortIndex Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortIndex])
  @@index([active, sortIndex])
}

model HomeFeaturedProduct {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortIndex Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId])
  @@index([sortIndex])
}

model AboutPageContent {
  id             String   @id @default("default")
  pageTitle      String
  pageSubtitle   String
  sections       Json
  storeAddressZh String?
  storeAddressEn String?
  storeHours     String?
  storeMtr       String?
  mapEmbedUrl    String?
  contactBody    String
  showStoreInfo  Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  condition String
  isFoil    Boolean @default(false)
  price     Float
  stock     Int     @default(0)
  sku       String  @unique
  orderItems OrderItem[]

  /// ADR-005: Inventory stocking system
  bookedStock       Int     @default(0)
  reservedStock     Int     @default(0)
  reservedNote      String?
  lowThreshold      Int?
  criticalThreshold Int?
  stockRecords      StockRecord[]

  @@index([productId])
  @@index([stock])
}

model Image {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

model Order {
  id              String      @id @default(uuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  email           String
  status          OrderStatus @default(PENDING)
  stripeSessionId String?     @unique
  totalAmount     Float
  currency        String      @default("hkd")
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Float
}

model Tournament {
  id           String                   @id @default(uuid())
  title        String                   @db.VarChar(250)
  slug         String                   @unique
  description  String?
  format       String                   @db.VarChar(250)
  maxPlayers   Int
  entryFee     Float                    @default(0)
  prizePool    String?
  location     String
  startsAt     DateTime
  registrationDeadline DateTime
  durationMinutes Int @default(120)
  status       TournamentStatus         @default(OPEN)
  registrations TournamentRegistration[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  deletedAt    DateTime?
}

model TournamentRegistration {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])
  playerName   String
  email        String
  phone        String?
  /// null = 免費賽事（無需付款）；"PENDING" = 待付款；"PAID" = 已付款
  paymentStatus String?
  stripeSessionId String? @unique
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, email])
  @@unique([tournamentId, phone])
}

/// ADR-003: Unified financial ledger for all transactions (orders + tournaments)
model Transaction {
  id           String           @id @default(uuid())
  type         TransactionType
  referenceId  String
  buyerType    BuyerType
  email        String
  customerName String?
  description  String
  amount       Float
  status       OrderStatus      @default(PENDING)
  remark       String?
  receiptData  Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([type])
  @@index([status])
  @@index([buyerType])
  @@index([createdAt])
  @@index([email])
}

/// ADR-004: Email-keyed points ledger. Balance = SUM(delta) WHERE email = ?
model PointLedger {
  id          String      @id @default(uuid())
  email       String
  delta       Int
  reason      PointReason
  referenceId String?
  note        String?
  createdAt   DateTime    @default(now())

  @@index([email])
  @@index([email, createdAt])
  @@index([referenceId, reason])
}

/// ADR-005: Stock booking/arrival state
enum StockState {
  BOOKED
  ARRIVED
}

/// ADR-005: One row per variant per stocking event
/// Denormalized fields survive product/variant deletion (onDelete: SetNull)
model StockRecord {
  id          String      @id @default(uuid())
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity    Int
  unitCost    Float
  state       StockState  @default(BOOKED)
  bookedAt    DateTime    @default(now())
  arrivedAt   DateTime?
  arrivalNote String?

  /// Denormalized snapshot — survives variant deletion
  productName      String
  variantCondition String
  variantIsFoil    Boolean  @default(false)

  @@index([variantId])
  @@index([state])
}

/// ADR-005: Global default thresholds (singleton)
model ShopSetting {
  id                       String   @id @default("default")
  defaultLowThreshold      Int      @default(5)
  defaultCriticalThreshold Int      @default(2)
  updatedAt                DateTime @updatedAt
}

/// ADR-006: Game type — top-level grouping above products and taxonomy
model GameType {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  products        Product[]
  taxonomyOptions TaxonomyOption[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// ADR-007: Coupon management — standalone record system
model Coupon {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String
  quantity    Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// ADR-006: Game type — top-level grouping above products and taxonomy