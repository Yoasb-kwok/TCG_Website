generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum TournamentStatus {
  DRAFT
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum UserRole {
  USER
  ADMIN
}

/** 後台可管理的標籤類型 */
enum TaxonomyKind {
  SET_CODE
  RARITY
  CARD_NUMBER
  CARD_CATEGORY
  POKEMON_ATTRIBUTE
  PRODUCT_TYPE
}

model TaxonomyOption {
  id          String       @id @default(uuid())
  kind        TaxonomyKind
  /** 儲存值（如 M3、RR、012） */
  value       String
  /** 顯示標籤 */
  label       String
  sortIndex   Int          @default(0)
  /** 卡號可掛在系列底下（parentValue = 系列編號） */
  parentValue String?
  /** 系列固定卡號後綴（SET_CODE 用，如 063 → 001/063） */
  cardSuffix  String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([kind, value, parentValue])
  @@index([kind, sortIndex])
  @@index([kind, parentValue])
}

model User {
  id            String                  @id @default(uuid())
  email         String                  @unique
  name          String?
  phone         String?
  passwordHash  String?
  role          UserRole                @default(USER)
  /** Pokémon ID（玩家 ID，供店務查核） */
  pokemonId     String?
  /** 會員積分 */
  points        Int                     @default(0)
  orders        Order[]
  registrations TournamentRegistration[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([pokemonId])
}

model Product {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique
  description    String?
  /** 對應標籤管理 PRODUCT_TYPE 的 value（如 SINGLE、BOOSTER_PACK、GIFT_BOX） */
  type           String
  cardSet        String?
  cardNumber     String?
  rarity         String?
  /** 系列編號：M1L、M3、M2A、SV3 等 */
  setCode        String?
  /** 稀有度分類：MUR、SAR、SR、AR、RR、R_SHINY、R、ITEM 等 */
  rarityTier     String?
  /** 卡牌類型：寶可夢、訓練家、物品、能量、場地 */
  cardCategory   String?
  setSortIndex   Int           @default(999)
  raritySortIndex Int          @default(99)
  /** 屬性：草、火、水、雷等（寶可夢卡） */
  pokemonType    String?
  language       String        @default("zh-HK")
  externalCardId String?
  variants       ProductVariant[]
  images         Image[]
  featuredEntries HomeFeaturedProduct[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([cardSet])
  @@index([rarity])
  @@index([setCode])
  @@index([rarityTier])
  @@index([setSortIndex])
  @@index([raritySortIndex])
  @@index([pokemonType])
  @@index([type])
}

model HomeBanner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String
  imageUrl  String
  href      String
  gradient  String
  sortIndex Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortIndex])
  @@index([active, sortIndex])
}

model MenuBanner {
  id        String   @id @default("default")
  imageUrl  String   @default("")
  href      String   @default("/products")
  title     String   @default("")
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model HomeFeaturedProduct {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortIndex Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId])
  @@index([sortIndex])
}

model AboutPageContent {
  id             String   @id @default("default")
  pageTitle      String
  pageSubtitle   String
  sections       Json
  storeAddressZh String?
  storeAddressEn String?
  storeHours     String?
  storeMtr       String?
  mapEmbedUrl    String?
  contactBody    String
  showStoreInfo  Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  condition String
  isFoil    Boolean @default(false)
  price     Float
  stock     Int     @default(0)
  sku       String  @unique
  /** 收銀條碼。空值代表未設定；有值時全店唯一（多個 NULL 可並存）。 */
  barcode   String? @unique
  orderItems OrderItem[]

  @@index([productId])
  @@index([stock])
}

model Image {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

model Order {
  id              String      @id @default(uuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  email           String
  status          OrderStatus @default(PENDING)
  stripeSessionId String?     @unique
  totalAmount     Float
  currency        String      @default("hkd")
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Float
}

model Tournament {
  id           String                   @id @default(uuid())
  title        String
  slug         String                   @unique
  description  String?
  format       String
  maxPlayers   Int
  entryFee     Float                    @default(0)
  prizePool    String?
  location     String
  startsAt     DateTime
  registrationDeadline DateTime
  status       TournamentStatus         @default(OPEN)
  registrations TournamentRegistration[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
}

model TournamentRegistration {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])
  playerName   String
  email        String?
  phone        String
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, phone])
}

enum PosPaymentMethod {
  CASH
  PAYME
  FPS
  CARD
}

enum PosExpenseCategory {
  GOODS
  RENT
  WAGES
  SUPPLIES
  UTILITIES
  OTHER
}

/** 收銀單。寫入資料庫，因為 Vercel 檔案系統不能持久保存 data/pos-ledger.json。 */
model PosSale {
  id            String           @id
  createdAt     DateTime         @default(now())
  paymentMethod PosPaymentMethod
  discount      Float            @default(0)
  note          String           @default("")
  voided        Boolean          @default(false)
  items         PosSaleItem[]

  @@index([createdAt])
  @@index([voided, createdAt])
}

model PosSaleItem {
  id        String  @id
  saleId    String
  sale      PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  name      String
  sku       String?
  quantity  Int
  unitPrice Float
  unitCost  Float
  sortIndex Int     @default(0)

  @@index([saleId, sortIndex])
}

model PosExpense {
  id        String             @id
  createdAt DateTime           @default(now())
  category  PosExpenseCategory
  amount    Float
  note      String             @default("")

  @@index([createdAt])
}

model PosReceipt {
  id        String   @id
  createdAt DateTime @default(now())
  productId String
  variantId String
  name      String
  sku       String?
  quantity  Int
  unitCost  Float
  unitPrice Float
  expenseId String   @unique

  @@index([createdAt])
  @@index([variantId])
}

/**
 * 自建系列卡表。執行時的來源是這張表加上後台 CSV 匯入，
 * 不是 TCGdex 或其他第三方 API。
 * code 照官方原文保存（M6、M6a、M-P 都可以），不要強制改大寫。
 */
model CatalogSet {
  id             String    @id @default(uuid())
  code           String    @unique
  nameZhTw       String?
  nameJa         String?
  nameEn         String?
  releaseDate    DateTime? @db.Date
  /** 賽制字母，例如 J。不是系列代碼。 */
  regulationMark String?
  officialUrl    String?
  totalCards     Int?
  cards          CatalogCard[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([releaseDate])
}

/**
 * 一張官方印刷的卡。collectorNumber 是匯入時採用的地區編號
 * （香港店以 asia.pokemon-card.com/hk 的收集編號為準）。
 */
model CatalogCard {
  id                 String     @id @default(uuid())
  setId              String
  set                CatalogSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  /** 例如 001/076 */
  collectorNumber    String
  /** 另一地區官方編號，只在與 collectorNumber 不同時填寫。 */
  altCollectorNumber String?
  sortIndex          Int        @default(0)
  /** 缺繁中譯名時寫「待補」。 */
  nameZhTw           String?
  nameJa             String?
  nameEn             String?
  imageUrl           String?
  imageUrlJa         String?
  rarity             String?
  illustrator        String?
  regulationMark     String?
  pendingTranslation Boolean    @default(false)
  /** 逗號分隔的缺欄，例如 nameZhTw,rarity。空字串代表沒有缺欄。 */
  missingFields      String     @default("")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([setId, collectorNumber])
  @@index([collectorNumber])
  @@index([altCollectorNumber])
  @@index([pendingTranslation])
  @@index([setId, sortIndex])
}

/** 每次卡表匯入或修正留一筆，供後台查看最近更新了哪個系列。 */
model CatalogChangelog {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  setCode   String
  note      String
  createdAt DateTime @default(now())

  @@index([date])
  @@index([setCode])
}
